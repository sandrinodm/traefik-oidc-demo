# Public host port. Traefik listens on container port 8080.
APP_PORT=80

# The original demo assumed TLS terminates before Traefik. For plain local HTTP,
# set both values to false and register http://localhost callbacks instead.
OIDC_COOKIE_SECURE=true
OIDC_FORCE_HTTPS=true
OIDC_LOG_LEVEL=WARN

# Provider 1: Google OIDC
# Register: https://<your-app-host>/oauth2/callback/provider-1
OIDC_PROVIDER_1_ENABLED=true
OIDC_PROVIDER_1_NAME=Google
OIDC_PROVIDER_1_ISSUER=https://accounts.google.com
OIDC_PROVIDER_1_CLIENT_ID=replace-with-google-client-id
OIDC_PROVIDER_1_CLIENT_SECRET=replace-with-google-client-secret
# Exactly 32 characters. Generate a unique value with: openssl rand -hex 16
OIDC_PROVIDER_1_SESSION_SECRET=0123456789abcdef0123456789abcdef

# Provider 2: Auth0 or another standards-compliant OIDC provider
# Register: https://<your-app-host>/oauth2/callback/provider-2
OIDC_PROVIDER_2_ENABLED=true
OIDC_PROVIDER_2_NAME=Auth0
OIDC_PROVIDER_2_ISSUER=https://your-tenant.eu.auth0.com/
OIDC_PROVIDER_2_CLIENT_ID=replace-with-auth0-client-id
OIDC_PROVIDER_2_CLIENT_SECRET=replace-with-auth0-client-secret
# Use a second, different 32-character value.
OIDC_PROVIDER_2_SESSION_SECRET=fedcba9876543210fedcba9876543210
