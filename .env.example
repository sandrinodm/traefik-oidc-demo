# Register https://<your-app-host>/oauth2/callback at your identity provider.
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=replace-with-your-client-id
OIDC_CLIENT_SECRET=replace-with-your-client-secret

# Exactly 32 random characters. Generate one with: openssl rand -hex 16
OIDC_SESSION_SECRET=0123456789abcdef0123456789abcdef

OIDC_CALLBACK_URI=/oauth2/callback
OIDC_COOKIE_SECURE=true
OIDC_LOG_LEVEL=WARN
APP_PORT=80
